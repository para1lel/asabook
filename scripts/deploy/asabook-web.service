[Unit]
Description=ASa Book static website
After=network.target

[Service]
Environment=XDG_DATA_HOME=/data1/shared/dongwu.chen/share
Environment=XDG_CONFIG_HOME=/data1/shared/dongwu.chen/config
ExecStart=/data1/shared/dongwu.chen/bin/caddy run --config /data1/shared/dongwu.chen/asabook/scripts/deploy/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
UMask=0022

[Install]
WantedBy=default.target
