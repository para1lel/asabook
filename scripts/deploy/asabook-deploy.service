[Unit]
Description=ASa Book GitHub synchronization and atomic publication
After=network.target asabook-web.service

[Service]
Type=oneshot
Environment=PATH=/data1/shared/dongwu.chen/software/node24/bin:/data1/shared/dongwu.chen/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_OPTIONS=--max-old-space-size=65536
Environment=npm_config_cache=/data1/shared/dongwu.chen/cache/npm
Environment=TMPDIR=/data1/shared/dongwu.chen/tmp
Environment=ASABOOK_GIT_PROXY=http://127.0.0.1:7890
UnsetEnvironment=http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY
ExecStartPre=/usr/bin/mkdir -p /data1/shared/dongwu.chen/state/asabook
ExecStart=/usr/bin/flock -n /data1/shared/dongwu.chen/state/asabook/deploy.lock /data1/shared/dongwu.chen/software/node24/bin/node /data1/shared/dongwu.chen/asabook/scripts/deploy/sync.mjs
KillMode=control-group
TimeoutStartSec=2h
TimeoutStopSec=30
NoNewPrivileges=true
UMask=0022
