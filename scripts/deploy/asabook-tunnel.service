[Unit]
Description=ASa Book Cloudflare Tunnel
After=network.target asabook-web.service

[Service]
UnsetEnvironment=http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY
ExecStart=/data1/shared/dongwu.chen/bin/cloudflared tunnel --no-autoupdate --config /data1/shared/dongwu.chen/config/cloudflared/asabook.yml run
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
